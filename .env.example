# Copy to .env on the NAS. Never commit the populated .env.
# Pin production to an explicit release. Do not use latest on the NAS.
AI_STUDIO_IMAGE=ghcr.io/yubse/agent-collab:v1.0.0
AI_STUDIO_ROOT=/volume1/AIStudio
AI_STUDIO_BIND_ADDRESS=127.0.0.1
AI_STUDIO_INTERNAL_PORT=3998
TZ=Asia/Shanghai

# Browser/Connector address served by Synology Reverse Proxy on the LAN.
AI_STUDIO_PUBLIC_URL=http://ai-studio-nas.local
# Optional explicit override. Use wss:// when the reverse proxy uses HTTPS.
CONNECTOR_WS_URL=ws://ai-studio-nas.local/connector

# Server waits longer than the 5-minute Connector execution deadline.
SERVER_PENDING_TIMEOUT_MS=330000

# Set a unique initial password of at least 10 characters. Remove after admin initialization.
AICOLLAB_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# Legacy privileged endpoints still require this independent random value (at least 16 chars).
AICOLLAB_AUTH_TOKEN=replace-with-an-independent-random-secret

# Production cookies become Secure automatically when Nginx sends X-Forwarded-Proto: https.
AICOLLAB_ALLOW_QUERY_TOKEN_AUTH=0
AICOLLAB_ALLOW_REMOTE_CONTROL=0

# Optional: override the compact role index injected into creative discussions.
CREATIVE_ROLE_KNOWLEDGE_PATH=/app/knowledge/company/白熊百货_创意角色优先级.md
